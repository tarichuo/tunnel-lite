[Unit]
Description=Tunnel Lite Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tunnel
Group=tunnel
WorkingDirectory=/opt/tunnel-agent
ExecStart=/opt/tunnel-agent/tunnel-agent -c /opt/tunnel-agent/agent.yaml
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
